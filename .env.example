# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=90

# Base de datos
DATABASE_PATH=./data/data.db
CSV_PATH=./data/data.csv

# API
MAX_QUERY_RESULTS=100
# --- API server (app/main.py) ---
# Max time (seconds) POST /ask will wait for a full answer before
# returning 504. Must be longer than OLLAMA_TIMEOUT_SECONDS * MAX_RETRIES,
# since a question can retry the model more than once.
ASK_TIMEOUT_SECONDS=120

# --- Ollama connection (app/text_to_sql.py) ---
# Local dev default. docker-compose.yml overrides this to the service
# name (http://ollama:11434) when running in Docker.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Timeout (seconds) for a single call to Ollama's /api/generate.
OLLAMA_TIMEOUT_SECONDS=90

# --- Text-to-SQL behavior (app/text_to_sql.py) ---
# How many times to retry generating SQL (with the real error fed back
# to the model) before giving up.
MAX_RETRIES=3
# Max rows any generated query can return; enforced by appending LIMIT
# if the model didn't include one.
MAX_QUERY_RESULTS=100

# --- Startup warm-up (app/main.py) ---
# Mainly relevant under Docker: the ollama service's healthcheck only
# confirms its server is responding, not that the model finished
# downloading. These retries wait out a slow `ollama pull`.
WARMUP_MAX_RETRIES=60
WARMUP_BACKOFF_SECONDS=5

# --- Data (app/db.py) ---
DATABASE_PATH=./data/data.db
CSV_PATH=./data/data.csv

